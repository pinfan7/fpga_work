// Reservation fragment only: add after implementing matching top-level ports.
// ACG720 60K / GW5AT-LV60PG484AC1/I0. UART names are from FPGA perspective.
// LEFT: P7.25 / P7.26; FRONT: P7.27 / P7.28; RIGHT: P7.31 / P7.32.
// Module TX -> FPGA RX; FPGA TX -> module RX. All logic must be 3.3 V compatible.
IO_LOC "tof_l_rx" B17;
IO_LOC "tof_l_tx" B18;
IO_LOC "tof_f_rx" C18;
IO_LOC "tof_f_tx" C19;
IO_LOC "tof_r_rx" D20;
IO_LOC "tof_r_tx" C20;
IO_PORT "tof_l_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "tof_f_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "tof_r_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "tof_l_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4;
IO_PORT "tof_f_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4;
IO_PORT "tof_r_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4;

IO_LOC "debug_tx" E19;
IO_PORT "debug_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4;
